# ============================================================
#  Second Brain — .env şablonu
#  Bu faylı KOPYALA -> .env  və dəyərləri doldur.
#  .env HEÇ VAXT git-ə düşmür (.gitignore-dadır). Açarları qorumaq üçün.
#  DİQQƏT: Bu fayla (.env.example) REAL açar yazma — o, git-də izlənir!
# ============================================================

# --- ƏSAS / Phase 0 (echo bot üçün MÜTLƏQ lazımdır) ---
# @BotFather -> /newbot -> verdiyi token
TELEGRAM_BOT_TOKEN=

# Sənin Telegram user ID-n (yalnız sən bota giriş edəsən).
# Bir neçə ID vergüllə: 12345678,87654321
# İlk açılışda boş qoysan, bot "open mode"-da işləyir və /id əmri sənə ID-ni göstərir.
ALLOWED_USER_IDS=

# --- Mühit / log ---
ENVIRONMENT=development        # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Saat qurşağı (reminders / tasks / səhər brifinqi) ---
TIMEZONE=Asia/Baku             # IANA tz adı (Azərbaycan = sabit UTC+4)

# --- Verilənlər bazası (docker-compose default-u ilə uyğun) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/second_brain

# ============================================================
#  Növbəti fazalar üçün — İNDİ boş qala bilər.
# ============================================================

# Phase 1: Claude "beyin"
ANTHROPIC_API_KEY=
# Agent beyni. Default Haiku 4.5 — xərc balansı (~3× ucuz, AZ güclü, canlı təsdiqlənib).
# Daha yüksək keyfiyyət istəyirsənsə: CLAUDE_MODEL_MAIN=claude-sonnet-5
CLAUDE_MODEL_MAIN=claude-haiku-4-5
CLAUDE_MODEL_FAST=claude-haiku-4-5

# Phase 1-2: OpenAI (Whisper STT + text-embedding-3-small)
OPENAI_API_KEY=

# Phase 1 (STT fallback) + Phase 3 (TTS): Azure Speech (az-AZ)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=                     # məs: westeurope, germanywestcentral
# Səsli cavab üçün default səs (istəyə bağlı): az-AZ-BabekNeural | az-AZ-BanuNeural
AZURE_TTS_VOICE=az-AZ-BabekNeural

# Phase 4: Tavily web axtarış
TAVILY_API_KEY=
