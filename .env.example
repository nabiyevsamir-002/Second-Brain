# ============================================================
#  Second Brain — .env şablonu
#  Bu faylı KOPYALA -> .env  və dəyərləri doldur.
#  .env HEÇ VAXT git-ə düşmür (.gitignore-dadır). Açarları qorumaq üçün.
#  DİQQƏT: Bu fayla (.env.example) REAL açar yazma — o, git-də izlənir!
# ============================================================

# --- ƏSAS (MÜTLƏQ lazımdır) ---
# @BotFather -> /newbot -> verdiyi token
TELEGRAM_BOT_TOKEN=

# Sənin Telegram user ID-n (yalnız sən bota giriş edəsən). Bir neçə ID vergüllə.
# İlk açılışda boş qoysan, bot "open mode"-da işləyir və /id əmri sənə ID-ni göstərir.
# Birinci ID e-poçt qutusunun sahibidir (yeni məktub bildirişləri ona gedir).
ALLOWED_USER_IDS=

# --- Mühit / log ---
ENVIRONMENT=production         # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Saat qurşağı (reminders / tasks / səhər brifinqi) ---
TIMEZONE=Asia/Baku             # IANA tz adı (Azərbaycan = sabit UTC+4)

# --- Verilənlər bazası (docker-compose default-u ilə uyğun) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/second_brain

# ============================================================
#  AI — Claude ABUNƏSİ (Pro/Max). API açarı LAZIM DEYİL.
# ============================================================
# Bir dəfə token al (brauzerdə Claude hesabına daxil olursan, 1 il etibarlıdır):
#   docker compose run --rm -it -e RUN_MIGRATIONS=0 bot claude setup-token
# Çıxan uzun tokeni (sk-ant-oat01-...) bura yapışdır.
CLAUDE_CODE_OAUTH_TOKEN=
LLM_BACKEND=auto               # auto | subscription | api  (auto: token varsa abunə)
# Agent beyni. Abunədə token başına ödəniş yoxdur; Haiku limitə daha az "yeyir".
CLAUDE_MODEL_MAIN=claude-haiku-4-5
CLAUDE_MODEL_FAST=claude-haiku-4-5
# Selective escalation: ÇƏTİN/analitik suallar bu modelə qalxır (sadələr Haiku).
CLAUDE_MODEL_SMART=claude-sonnet-5
ESCALATION_ENABLED=true        # false = həmişə Haiku (abunə limitinə ən qənaətcil)
AGENT_MAX_TURNS=8
LLM_TIMEOUT_SEC=180

# Embedding (axtarış) + səs tanıma LOKAL işləyir (CPU) — OpenAI açarı lazım deyil.
# İlk işə salmada modellər endirilir (~4GB, "models" Docker volume-unda saxlanır).
EMBED_BACKEND=auto             # auto | local | openai  (auto: OPENAI_API_KEY yoxdursa local)
STT_BACKEND=auto               # auto | local | openai
WHISPER_MODEL=large-v3         # ən dəqiq, RAM pik ~5GB | large-v3-turbo | medium | small (ən sürətli, ən çox səhv)

# --- E-poçt (IMAP, YALNIZ oxuma — bot heç nə silmir/göndərmir, "oxunmuş" da etmir) ---
# Gmail: myaccount.google.com → Security → 2-Step Verification AÇ → "App passwords" →
# yeni parol yarat (16 simvol) → EMAIL_PASSWORD-a yaz. Adi Google parolu İŞLƏMİR.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_CHECK_INTERVAL_MIN=10    # yeni məktub bildirişi hər N dəqiqə (0 = söndürülü)
EMAIL_AI_TRIAGE=true           # vacib/adi ayırma — reklamlar AI-siz süzülür

# Rate-limit — runaway istifadəyə qarşı. 0 = limitsiz.
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_HOUR=240

# Soft aylıq büdcə — USD, istifadəçi başına (usage_log). 0 = söndürülü.
# Abunə rejimində real ödəniş yoxdur (rəqəmlər API ekvivalentidir) → adətən 0 saxla.
# API rejimində məs. 20: limitin BUDGET_WARN_PCT %-ində xəbərdarlıq, keçəndə bot dayanmır —
# yalnız Sonnet eskalasiyası + səsli cavab ayın sonunadək söndürülür.
MONTHLY_BUDGET_USD=0
BUDGET_WARN_PCT=80

# ============================================================
#  İSTƏYƏ BAĞLI — pullu API açarları (abunə rejimində BOŞ qoy)
# ============================================================
# Anthropic API (yalnız LLM_BACKEND=api üçün; token başına ödəniş)
ANTHROPIC_API_KEY=
# OpenAI: Whisper STT + text-embedding-3-small (boşdursa lokal modellər işləyir)
OPENAI_API_KEY=
# Azure Speech (az-AZ səsli cavab /voice) — boşdursa səsli cavab söndürülüdür
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=                     # məs: westeurope, germanywestcentral
AZURE_TTS_VOICE=az-AZ-BabekNeural        # az-AZ-BabekNeural | az-AZ-BanuNeural
# Tavily web axtarış — yalnız API rejimi (abunə agenti daxili WebSearch işlədir)
TAVILY_API_KEY=

# Monitoring / uptime (dead man's switch — istəyə bağlı)
# healthchecks.io-da pulsuz check yarat → "ping URL"-i bura yaz. Bot hər 5 dəq ping atır;
# ping kəsilsə (bot/DB/PC düşüb) healthchecks.io sənə alert göndərir. Boş = söndürülü.
HEALTHCHECK_URL=
HEARTBEAT_INTERVAL_MIN=5
